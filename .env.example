# Backend runtime
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8000
JARVIS_LOG_LEVEL=INFO

# Speech: start with CPU. Use cuda only when CTranslate2/CUDA is configured.
JARVIS_ENABLE_MICROPHONE=true
JARVIS_MICROPHONE_DEVICE=
JARVIS_SPEECH_MODEL=base.en
JARVIS_SPEECH_DEVICE=cpu
JARVIS_SPEECH_COMPUTE_TYPE=int8
JARVIS_SPEECH_LANGUAGE=en
JARVIS_SPEECH_VAD_THRESHOLD=0.012
JARVIS_SPEECH_SILENCE_DURATION_MS=900

# OpenAI: leave blank to use the local fallback provider.
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant: enable only after a Qdrant instance is running.
JARVIS_ENABLE_QDRANT=false
JARVIS_QDRANT_URL=http://127.0.0.1:6333
JARVIS_QDRANT_API_KEY=
JARVIS_QDRANT_COLLECTION=jarvis_memory

# Browser automation
JARVIS_ENABLE_BROWSER_ACTIONS=true
JARVIS_BROWSER_HEADLESS=false

# Optional ElevenLabs voice output
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=

# Real monitoring connector: IMAP read-only unread summaries.
JARVIS_ENABLE_EMAIL_CONNECTOR=false
JARVIS_EMAIL_IMAP_HOST=
JARVIS_EMAIL_IMAP_PORT=993
JARVIS_EMAIL_IMAP_USERNAME=
JARVIS_EMAIL_IMAP_PASSWORD=
JARVIS_EMAIL_IMAP_FOLDER=INBOX

# SMTP sending: every outbound email is confirmation-gated, including attachments.
JARVIS_EMAIL_SMTP_HOST=smtp.gmail.com
JARVIS_EMAIL_SMTP_PORT=465
JARVIS_EMAIL_SMTP_USERNAME=
JARVIS_EMAIL_SMTP_PASSWORD=
JARVIS_EMAIL_FROM_ADDRESS=
JARVIS_EMAIL_SMTP_USE_SSL=true
JARVIS_EMAIL_MAX_ATTACHMENT_BYTES=20000000
