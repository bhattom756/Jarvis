{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "agents/*",
    "services/*"
  ],
  "scripts": {
    "build": "npx turbo run build",
    "typecheck": "npx turbo run typecheck",
    "test": "npx turbo run test",
    "dev:core": "npm --prefix services/core run dev",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "build:desktop": "npm --prefix apps/desktop run build"
  },
  "devDependencies": {
    "turbo": "2.10.11",
    "typescript": "^5.9.3"
  }
}
